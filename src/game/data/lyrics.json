  "tokeruyoru": [
    {
      "text": "Cold winter night in Chiba city.",
      "startMs": 0,
      "endMs": 5000
    },
    {
      "text": "We were just chasing the memories.",
      "startMs": 5000,
      "endMs": 8000
    },
    {
      "text": "One last time in this small room.",
      "startMs": 8000,
      "endMs": 12000
    },
    {
      "text": "(Don't let it fade away)",
      "startMs": 12000,
      "endMs": 14000
    },
    {
      "text": "カラオケの灯りだけが揺れている",
      "startMs": 14000,
      "endMs": 19000
    },
    {
      "text": "冷たい千葉の夜風を忘れるように",
      "startMs": 19000,
      "endMs": 22000
    },
    {
      "text": "君の歌う声が優しすぎて",
      "startMs": 22000,
      "endMs": 26000
    },
    {
      "text": "胸の奥がぎゅっと痛むんだ",
      "startMs": 26000,
      "endMs": 31000
    },
    {
      "text": "ふたりで分けたチョコミントの味",
      "startMs": 31000,
      "endMs": 34000
    },
    {
      "text": "甘くて苦いこの夜の結末",
      "startMs": 34000,
      "endMs": 37000
    },
    {
      "text": "君のその口癖がいつの間にか",
      "startMs": 37000,
      "endMs": 42000
    },
    {
      "text": "私にもうつってしまったみたい",
      "startMs": 42000,
      "endMs": 46000
    },
    {
      "text": "明日になれば違う空の下",
      "startMs": 46000,
      "endMs": 49000
    },
    {
      "text": "もう繋がらない距離がもどかしい",
      "startMs": 49000,
      "endMs": 53000
    },
    {
      "text": "ねえ行かないでと叫べたらいいのに",
      "startMs": 53000,
      "endMs": 57000
    },
    {
      "text": "言葉は雪のように消えていく",
      "startMs": 57000,
      "endMs": 61000
    },
    {
      "text": "ずっとそばにいたいよ",
      "startMs": 61000,
      "endMs": 64000
    },
    {
      "text": "この雪がすべてを白く染めても",
      "startMs": 64000,
      "endMs": 68000
    },
    {
      "text": "離したくないその手を",
      "startMs": 68000,
      "endMs": 73500
    },
    {
      "text": "君のぬくもりを忘れたくない",
      "startMs": 73500,
      "endMs": 76000
    },
    {
      "text": "チョコミントの甘い記憶",
      "startMs": 76000,
      "endMs": 80000
    },
    {
      "text": "カラオケの部屋に残したまま",
      "startMs": 80000,
      "endMs": 84000
    },
    {
      "text": "旅立ちの朝が来る前に",
      "startMs": 84000,
      "endMs": 87000
    },
    {
      "text": "もう一度だけ抱きしめて",
      "startMs": 87000,
      "endMs": 91000
    },
    {
      "text": "髪が少し伸びた君の横顔",
      "startMs": 91000,
      "endMs": 94000
    },
    {
      "text": "見つめるだけで涙が溢れそう",
      "startMs": 94000,
      "endMs": 98000
    },
    {
      "text": "チョコミントの最後の一口",
      "startMs": 98000,
      "endMs": 101000
    },
    {
      "text": "切なさが喉の奥で溶けていく",
      "startMs": 101000,
      "endMs": 105000
    },
    {
      "text": "約束なんて出来なくても",
      "startMs": 105000,
      "endMs": 108000
    },
    {
      "text": "心はいつも繋がっていると",
      "startMs": 108000,
      "endMs": 113000
    },
    {
      "text": "信じることしか出来ないから",
      "startMs": 113000,
      "endMs": 117000
    },
    {
      "text": "今はただこの瞬間を生きる",
      "startMs": 117000,
      "endMs": 121000
    },
    {
      "text": "ずっとそばにいたいよ",
      "startMs": 121000,
      "endMs": 124000
