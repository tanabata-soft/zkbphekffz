  "chocomint": [
    {
      "text": "潮風が噎せ返る千葉のネオン",
      "startMs": 12900,
      "endMs": 15700
    },
    {
      "text": "指先で溶け出したチョコミントの憂鬱",
      "startMs": 15700,
      "endMs": 19000
    },
    {
      "text": "甘さでは誤魔化しきれない傷跡を",
      "startMs": 19000,
      "endMs": 21500
    },
    {
      "text": "淀んだ夜の底へ泥のように飲み込んだ",
      "startMs": 21500,
      "endMs": 24600
    },
    {
      "text": "逃げ込んだ狭いカラオケの密室",
      "startMs": 24600,
      "endMs": 27700
    },
    {
      "text": "ノイズ混じりのスピーカーマイクに縋るように",
      "startMs": 27700,
      "endMs": 32100
    },
    {
      "text": "誰にも届かない孤独な悲鳴すら",
      "startMs": 32100,
      "endMs": 35100
    },
    {
      "text": "今は極彩色の火花に変えてみせるから",
      "startMs": 35100,
      "endMs": 38100
    },
    {
      "text": "響け、私の声！終わらない夜を切り裂いて",
      "startMs": 38100,
      "endMs": 45100
    },
    {
      "text": "冷たくて痛いほどの迷いを蹴り飛ばし",
      "startMs": 45100,
      "endMs": 48100
    },
    {
      "text": "這い上がるこの街のステージで",
      "startMs": 48100,
      "endMs": 51100
    },
    {
      "text": "命を焦がして艶やかに歌い上げるんだ",
      "startMs": 51100,
      "endMs": 57600
    },
    {
      "text": "消えない残響を鮮やかな明日へ叩きつけるまで",
      "startMs": 57600,
